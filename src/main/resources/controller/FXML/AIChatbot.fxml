<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.Glow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>


<AnchorPane prefHeight="800.0" prefWidth="1080.0" style="-fx-background-color: #25201f;" stylesheets="@../../css/fullpackstyling.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AIChatbotController">
   <children>
      <Button layoutX="130.0" layoutY="5.0" mnemonicParsing="false" style="-fx-background-color: trans; -fx-border-width: 2;" textFill="#282322">
         <graphic>
            <FontIcon iconColor="WHITE" iconLiteral="fth-edit" iconSize="35" />
         </graphic>
      </Button>
      <Label alignment="CENTER" layoutX="5.0" layoutY="10.0" prefHeight="40.0" prefWidth="130.0" style="-fx-font-family: &quot;Poppins-ExtraBold&quot;; -fx-font-weight: bold; -fx-font-size: 23;" text="AI-Chatbot" textFill="WHITE">
         <effect>
            <Glow />
         </effect>
         <font>
            <Font size="13.0" />
         </font>
      </Label>
      <ScrollPane layoutX="190.0" prefHeight="740.0" prefWidth="700.0" style="-fx-background-color: black;" />
      <HBox layoutX="190.0" layoutY="740.0" prefHeight="60.0" prefWidth="700.0">
         <children>
            <TextField prefHeight="60.0" prefWidth="638.0" promptText="Send a message ..." style="-fx-background-color: #1D1918; -fx-background-radius: 15px 0px 0px 0px; -fx-border-color: white; -fx-border-radius: 15px 0px 0px 15px; -fx-font-size: 20;" />
            <Button mnemonicParsing="false" prefHeight="60.0" prefWidth="77.0" style="-fx-background-color: #1D1918; -fx-border-color: white; -fx-border-radius: 0px 15px 15px 0px;">
               <font>
                  <Font name="System Bold" size="25.0" />
               </font>
               <graphic>
                  <FontIcon iconColor="WHITE" iconLiteral="fth-corner-right-up" iconSize="40" />
               </graphic>
            </Button>
         </children>
      </HBox>
   </children>
</AnchorPane>
