<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane fx:id="taskRootNode" prefHeight="61.0" prefWidth="215.0" stylesheets="@../../css/fullpackstyling.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.TaskController">
   <children>
      <RadioButton fx:id="doneTaskRadioBtn" layoutX="5.0" layoutY="21.0" mnemonicParsing="false" onMouseClicked="#doneTaskRadioBtnClicked" style="-fx-font-family: &quot;Poppins-ExtraBold&quot;; -fx-font-size: 18; -fx-font-weight: bold;" textFill="WHITE" />
      <Button fx:id="deleteTaskBtn" layoutX="170.0" layoutY="15.0" mnemonicParsing="false" onMouseClicked="#deleteTaskBtnClicked" prefHeight="31.0" prefWidth="37.0" style="-fx-background-radius: 15; -fx-background-color: transparent; -fx-border-radius: 30; -fx-border-width: 2;">
         <graphic>
            <FontIcon iconColor="WHITE" iconLiteral="fth-x" iconSize="30" wrappingWidth="31.0" />
         </graphic>
         <font>
            <Font size="1.0" />
         </font>
      </Button>
      <Label fx:id="taskNameLabel" layoutX="35.0" layoutY="17.0" prefHeight="31.0" prefWidth="138.0" style="-fx-font-style: italic; -fx-font-weight: bold; -fx-font-size: 17;" text="Task 1" textFill="WHITE">
         <font>
            <Font name="System Bold Italic" size="17.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
